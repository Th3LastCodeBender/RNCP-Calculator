{
  "name": "rncp-calculator",
  "private": true,
  "scripts": {
    "build": "tsc && node tools/version-assets.mjs",
    "version": "node tools/version-assets.mjs",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "hours": "node --env-file-if-exists=.env tools/fetch-hours.mjs && node tools/version-assets.mjs",
    "subjects": "node --env-file-if-exists=.env tools/fetch-subjects.mjs",
    "info": "node --env-file-if-exists=.env tools/fetch-info.mjs",
    "subjects:summary": "node tools/subjects-summary.mjs",
    "rncp": "node tools/rncp-lists.mjs",
    "me": "node --env-file-if-exists=.env tools/fetch-me.mjs",
    "serve": "node tools/serve.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
